# Copy to .env.local and fill in. .env.local is never committed.
# Production: the same five variables in Vercel → Settings → Environment
# Variables (see docs/DEPLOIEMENT.md).

# Supabase API. Local values: `npx supabase status` (API_URL, PUBLISHABLE_KEY).
# Production: Supabase dashboard → Project Settings → API (project URL and the
# publishable / anon key), project in the Canada (Central) region.
# Only the public anon / publishable key goes here: it can only read what RLS allows.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Map style (vector tiles). Default: OpenFreeMap, no key needed.
# MapTiler example: https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Mapbox routing (road distances /api/detours, turn-by-turn /api/itineraire). SERVER SIDE ONLY: never prefix
# with NEXT_PUBLIC_, or it would be copied into the browser code. Optional: without
# it, detours are estimated as straight-line round trips and in-site guidance is
# replaced by the Waze / Google Maps / Apple Maps links.
# Create a token at https://account.mapbox.com/access-tokens/ (no special scope needed).
MAPBOX_DIRECTIONS_TOKEN=

# Anti-robot check before a sign-in code is sent (Cloudflare Turnstile).
# Local: Cloudflare's public test key below (always passes), paired with the test
# secret in supabase/config.toml. Production: create a widget at
# https://dash.cloudflare.com → Turnstile, put its site key here and its SECRET
# key in Supabase (Authentication → Attack Protection), never here.
# Empty = no check: then [auth.captcha] must be disabled in Supabase too.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
